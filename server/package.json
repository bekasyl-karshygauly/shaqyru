{
  "name": "shaqyru-app",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node --env-file=.env server.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "test:workflow": "playwright test --config playwright.workflow.config.js",
    "test:motion": "playwright test --config playwright.scroll.config.js",
    "test:webgl": "playwright test --config playwright.webgl.config.js",
    "telegram:connect": "node --env-file=.env scripts/connect-telegram.js",
    "audio:cleanup": "node --env-file=.env scripts/cleanup-audio.js",
    "assets:build": "node scripts/optimize-covers.js",
    "assets:three": "node scripts/build-three-vendor.js",
    "check": "node scripts/check-source.js",
    "account:check": "node --env-file=.env scripts/check-account-setup.js",
    "prepare:layout": "node scripts/prepare-upload-layout.js",
    "prestart": "node scripts/prepare-upload-layout.js",
    "pretest": "node scripts/prepare-upload-layout.js",
    "pretest:browser": "node scripts/prepare-upload-layout.js",
    "pretest:workflow": "node scripts/prepare-upload-layout.js",
    "pretest:motion": "node scripts/prepare-upload-layout.js",
    "pretest:webgl": "node scripts/prepare-upload-layout.js",
    "pretelegram:connect": "node scripts/prepare-upload-layout.js",
    "preaudio:cleanup": "node scripts/prepare-upload-layout.js",
    "preassets:build": "node scripts/prepare-upload-layout.js",
    "preassets:three": "node scripts/prepare-upload-layout.js",
    "precheck": "node scripts/prepare-upload-layout.js",
    "preaccount:check": "node scripts/prepare-upload-layout.js"
  },
  "engines": {
    "node": ">=20.6"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.11",
    "express": "^4.19.2",
    "fast-xml-parser": "^5.11.2",
    "gsap": "3.15.0",
    "qrcode-generator": "^2.0.4",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "esbuild": "0.28.2",
    "jsqr": "^1.4.0"
  }
}
